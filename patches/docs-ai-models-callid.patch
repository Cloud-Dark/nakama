+
+
+/*
+ * Regresi: model provider non-default WAJIB dipanggil dengan awalan slug
+ * (mis. "bansos/claude-opus-5-5"). Gateway menghitungnya di `callId`; `id`
+ * adalah public id tanpa awalan. Menampilkan/menyalin `id` membuat permintaan
+ * jatuh ke provider default dan gagal "model tidak tersedia" - persis keluhan
+ * "model Bansos tidak ada di list" yang memicu perbaikan ini.
+ */
+test('parseAiCatalog: callId dipertahankan, dan mundur ke id bila server lama belum mengirimnya', () => {
+  const parsed = parseAiCatalog({
+    coinPerCredit: 18500,
+    freeDailyRequests: 10,
+    total: 2,
+    models: [
+      { id: 'claude-opus-5-5', callId: 'bansos/claude-opus-5-5', name: 'Claude Opus 5.5', provider: 'Bansos', format: 'anthropic', modality: 'text' },
+      { id: 'openai/gpt-4o-mini', name: 'GPT-4o mini', provider: 'OpenRouter', format: 'openai', modality: 'text' },
+    ],
+  });
+  assert.ok(parsed);
+  assert.equal(parsed.models.length, 2);
+  // Provider non-default: awalan slug dipertahankan apa adanya dari server.
+  assert.equal(parsed.models[0].id, 'claude-opus-5-5');
+  assert.equal(parsed.models[0].callId, 'bansos/claude-opus-5-5');
+  // Server versi lama tanpa callId: id adalah jawaban yang benar.
+  assert.equal(parsed.models[1].callId, 'openai/gpt-4o-mini');
+});
+
+test('cuplikan kode memakai callId, bukan id tanpa awalan', () => {
+  const bansos = model({ id: 'claude-opus-5-5', callId: 'bansos/claude-opus-5-5', provider: 'Bansos', format: 'anthropic', endpoint: 'POST /v1/ai/messages' });
+  for (const code of [curlFor(bansos), sdkFor(bansos).code]) {
+    assert.match(code, /bansos\/claude-opus-5-5/);
+    // Tidak boleh ada nama model tanpa awalan slug di posisi field `model`.
+    assert.doesNotMatch(code, /"claude-opus-5-5"/);
+  }
+});
